<Window x:Class="Osdu.Client.ExampleApp.ApiTestWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Osdu.Client.ExampleApp"
        mc:Ignorable="d"
        Title="ApiTestWindow" Height="450" Width="800">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Left Panel: API List -->
        <Border Grid.Column="0" Background="#F0F0F0" BorderBrush="#CCCCCC" BorderThickness="0,0,1,0">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="APIs" FontWeight="Bold" FontSize="16"
                           Margin="12,12,12,8"/>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="ApiButtonsPanel" Margin="8,0,8,8"/>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- Right Panel: Dynamic UI -->
        <Grid Grid.Column="1" Margin="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="200"/>
            </Grid.RowDefinitions>

            <TextBlock x:Name="ApiTitleText" Grid.Row="0" FontSize="20" FontWeight="Bold" Margin="0,0,0,12"/>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="EndpointsPanel"/>
            </ScrollViewer>

            <GridSplitter Grid.Row="2" Height="5" HorizontalAlignment="Stretch" Background="#CCCCCC" Margin="0,8"/>

            <DockPanel Grid.Row="3">
                <TextBlock DockPanel.Dock="Top" Text="Response" FontWeight="Bold" Margin="0,4,0,4"/>
                <TextBox x:Name="ResponseTextBox" IsReadOnly="True"
                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                         TextWrapping="Wrap" FontFamily="Consolas" FontSize="11"
                         AcceptsReturn="True" Background="#1E1E1E" Foreground="#D4D4D4"/>
            </DockPanel>
        </Grid>
    </Grid>
</Window>
